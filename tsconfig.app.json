{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2024",
    "tsBuildInfoFile": ".dev/cache/typescript/app.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
